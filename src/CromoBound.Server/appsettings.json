{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CromoBound": {
    "DatabasePath": "cromobound.db",
    "DataFolder": "data",
    "LoginRequestsPerMinute": 10,
    "LockoutFailures": 5,
    "LockoutMinutes": 15,
    "CookieHours": 12,
    "KnownProxies": []
  }
}
